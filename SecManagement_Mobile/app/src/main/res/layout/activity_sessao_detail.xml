<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sessão"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:textColor="@color/textPrimary"/>

                <Button
                    android:id="@+id/btnVoltar"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Voltar"
                    android:textColor="@color/textPrimary"
                    android:backgroundTint="@color/inputDark"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                style="@style/AtecCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtModulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/textPrimary"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/txtHora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/txtTurma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Turma: —"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/txtFormador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Formador: —"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/txtSala"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sala: —"
                        android:textColor="@color/textSecondary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
